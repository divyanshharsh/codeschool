# Vercel ignore file
# Files and folders to exclude from Vercel deployment

# Backend (deploy separately)
backend/
backend/**/*

# Documentation
*.md
!README.md

# Git
.git/
.gitignore

# Node modules (will be installed by Vercel)
node_modules/

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Build artifacts (will be generated)
dist/
build/

